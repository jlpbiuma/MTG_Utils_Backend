# ==============================================================================
# MTG UTILS BACKEND - LOCAL ENVIRONMENT VARIABLES
# ==============================================================================

# 1. LOCAL POSTGRESQL DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mtg_utils?schema=public"

# 2. EXTERNAL API KEYS (OPTIONAL)
CARDTRADER_API_TOKEN="your-cardtrader-bearer-token"

# 3. OCR HOME (card scan from image)
OCR_API_URL="http://host.docker.internal:8020"
OCR_API_TOKEN=""
OCR_API_TIMEOUT=15
