# ==============================================================================
# MTG UTILS - FULLSTACK NEXT.JS ENVIRONMENT VARIABLES
# ==============================================================================

# 1. DATABASE CONFIGURATION (SERVER-ONLY - NEVER EXPOSED TO CLIENT)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL connection string (Transaction Pooler - port 6543)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mtg_utils?schema=public"

# Supabase direct connection string for running Prisma migrations (Session/Direct - port 5432)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mtg_utils?schema=public"

# 2. SUPABASE CREDENTIALS
# ------------------------------------------------------------------------------
# Server-only private key (NEVER prefix with NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Public keys accessible in client if needed (protected by Supabase RLS)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# 3. APP CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
